// Velox self-hosted compiler lexer.
// Token record layout: [kind, byte_start, byte_end].
// Identifier and string contents remain represented by source spans.

fn lex_char(source: str, index: i64, length: i64) -> i64 {
    if index < 0 || index >= length {
        return 0;
    }
    return str_byte_at_fast(source, index, length);
}

fn lex_digit(c: i64) -> bool {
    return c >= 48 && c <= 57;
}

fn lex_alpha(c: i64) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;
}

fn lex_alnum(c: i64) -> bool {
    return lex_alpha(c) || lex_digit(c);
}

fn lex_space(c: i64) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn lex_keyword(source: str, start: i64, end: i64) -> i64 {
    let word: str = str_slice(source, start, end);

    if str_eq(word, "fn") { return 5; }
    if str_eq(word, "struct") { return 6; }
    if str_eq(word, "let") { return 7; }
    if str_eq(word, "mut") { return 8; }
    if str_eq(word, "return") { return 9; }
    if str_eq(word, "if") { return 10; }
    if str_eq(word, "else") { return 11; }
    if str_eq(word, "while") { return 12; }
    if str_eq(word, "for") { return 13; }
    if str_eq(word, "in") { return 14; }
    if str_eq(word, "true") { return 15; }
    if str_eq(word, "false") { return 16; }
    if str_eq(word, "parallel") { return 17; }
    if str_eq(word, "pub") { return 18; }
    if str_eq(word, "export") { return 19; }

    return 1;
}

fn lex_push(tokens: i64, kind: i64, start: i64, end: i64) {
    list_i64_push(tokens, kind);
    list_i64_push(tokens, start);
    list_i64_push(tokens, end);
}

pub fn tokenize(source: str) -> i64 {
    let tokens: i64 = list_i64_new();
    let length: i64 = str_len(source);
    let mut pos: i64 = 0;

    while pos < length {
        let c: i64 = lex_char(source, pos, length);

        if lex_space(c) {
            pos = pos + 1;
        } else {
            if c == 47 && pos + 1 < length && lex_char(source, pos + 1, length) == 47 {
                pos = pos + 2;
                while pos < length && (lex_char(source, pos, length) < 10 || lex_char(source, pos, length) > 10) {
                    pos = pos + 1;
                }
            } else {
                if c == 47 && pos + 1 < length && lex_char(source, pos + 1, length) == 42 {
                    let mut closed: bool = false;
                    pos = pos + 2;

                    while pos < length && closed == false {
                        if lex_char(source, pos, length) == 42 &&
                           pos + 1 < length &&
                           lex_char(source, pos + 1, length) == 47 {
                            pos = pos + 2;
                            closed = true;
                        } else {
                            pos = pos + 1;
                        }
                    }

                    if closed == false {
                        lex_push(tokens, -1, pos, pos);
                        return tokens;
                    }
                } else {
                    let start: i64 = pos;

                    if lex_alpha(c) {
                        pos = pos + 1;
                        while pos < length && lex_alnum(lex_char(source, pos, length)) {
                            pos = pos + 1;
                        }
                        lex_push(tokens, lex_keyword(source, start, pos), start, pos);
                    } else {
                        if lex_digit(c) {
                            pos = pos + 1;
                            while pos < length && lex_digit(lex_char(source, pos, length)) {
                                pos = pos + 1;
                            }

                            let mut kind: i64 = 2;
                            if pos + 1 < length &&
                               lex_char(source, pos, length) == 46 &&
                               lex_digit(lex_char(source, pos + 1, length)) {
                                kind = 3;
                                pos = pos + 1;
                                while pos < length && lex_digit(lex_char(source, pos, length)) {
                                    pos = pos + 1;
                                }
                            }

                            // Scientific notation: optional exponent sign, mandatory digits.
                            if pos < length &&
                               (lex_char(source, pos, length) == 101 ||
                                lex_char(source, pos, length) == 69) {
                                kind = 3;
                                pos = pos + 1;
                                if pos < length &&
                                   (lex_char(source, pos, length) == 43 ||
                                    lex_char(source, pos, length) == 45) {
                                    pos = pos + 1;
                                }
                                if pos >= length ||
                                   lex_digit(lex_char(source, pos, length)) == false {
                                    lex_push(tokens, -1, start, pos);
                                    return tokens;
                                }
                                while pos < length && lex_digit(lex_char(source, pos, length)) {
                                    pos = pos + 1;
                                }
                            }
                            lex_push(tokens, kind, start, pos);
                        } else {
                            if c == 34 {
                                pos = pos + 1;
                                let mut closed: bool = false;
                                let mut bad: bool = false;

                                while pos < length && closed == false && bad == false {
                                    let ch: i64 = lex_char(source, pos, length);

                                    if ch == 34 {
                                        pos = pos + 1;
                                        closed = true;
                                    } else {
                                        if ch == 92 {
                                            pos = pos + 1;
                                            if pos >= length {
                                                bad = true;
                                            } else {
                                                let escaped: i64 = lex_char(source, pos, length);
                                                if escaped == 110 || escaped == 116 ||
                                                   escaped == 114 || escaped == 48 ||
                                                   escaped == 92 || escaped == 34 {
                                                    pos = pos + 1;
                                                } else {
                                                    bad = true;
                                                }
                                            }
                                        } else {
                                            if ch == 0 {
                                                bad = true;
                                            } else {
                                                pos = pos + 1;
                                            }
                                        }
                                    }
                                }

                                if closed == false || bad {
                                    lex_push(tokens, -1, start, pos);
                                    return tokens;
                                }
                                lex_push(tokens, 4, start, pos);
                            } else {
                                let mut kind: i64 = -1;
                                let mut width: i64 = 1;
                                let next: i64 = lex_char(source, pos + 1, length);

                                if c == 40 { kind = 20; }
                                else if c == 41 { kind = 21; }
                                else if c == 123 { kind = 22; }
                                else if c == 125 { kind = 23; }
                                else if c == 44 { kind = 24; }
                                else if c == 59 { kind = 25; }
                                else if c == 58 { kind = 26; }
                                else if c == 43 { kind = 30; }
                                else if c == 42 { kind = 32; }
                                else if c == 47 { kind = 33; }
                                else if c == 37 { kind = 34; }
                                else if c == 33 {
                                    kind = 43;
                                    if next == 61 { kind = 44; width = 2; }
                                }
                                else if c == 45 {
                                    kind = 31;
                                    if next == 62 { kind = 27; width = 2; }
                                }
                                else if c == 61 {
                                    kind = 35;
                                    if next == 61 { kind = 36; width = 2; }
                                }
                                else if c == 60 {
                                    kind = 37;
                                    if next == 61 { kind = 39; width = 2; }
                                }
                                else if c == 62 {
                                    kind = 38;
                                    if next == 61 { kind = 40; width = 2; }
                                }
                                else if c == 46 {
                                    kind = 29;
                                    if next == 46 { kind = 28; width = 2; }
                                }
                                else if c == 38 && next == 38 {
                                    kind = 41;
                                    width = 2;
                                }
                                else if c == 124 && next == 124 {
                                    kind = 42;
                                    width = 2;
                                }

                                if kind < 0 {
                                    lex_push(tokens, -1, start, start + 1);
                                    return tokens;
                                }

                                pos = pos + width;
                                lex_push(tokens, kind, start, pos);
                            }
                        }
                    }
                }
            }
        }
    }

    lex_push(tokens, 0, length, length);
    return tokens;
}

// Velox self-hosted compiler: C backend

fn cg_slice(source: str, start: i64, end: i64) -> str {
    if start < 0 || end < start || end > str_len(source) {
        return "";
    }
    return str_slice(source, start, end);
}

fn cg_node(nodes: i64, node: i64, field: i64) -> i64 {
    return ast_node_data(nodes, node, field);
}

fn cg_mangle(prefix: str, name: str) -> str {
    let digits: str = "0123456789abcdef";
    let mut result: str = prefix;
    let mut i: i64 = 0;

    while i < str_len(name) {
        let byte: i64 = str_byte_at(name, i);
        let high: i64 = byte / 16;
        let low: i64 = byte % 16;
        result = str_concat(result, str_slice(digits, high, high + 1));
        result = str_concat(result, str_slice(digits, low, low + 1));
        i = i + 1;
    }
    return result;
}

fn cg_name(source: str, nodes: i64, node: i64, prefix: str) -> str {
    return cg_mangle(prefix,
        cg_slice(source, cg_node(nodes, node, 1),
                        cg_node(nodes, node, 2)));
}

fn cg_type(source: str, nodes: i64, node: i64) -> str {
    if node < 0 { return "void"; }
    let name: str = cg_slice(source,
        cg_node(nodes, node, 1), cg_node(nodes, node, 2));

    if str_eq(name, "i64") { return "int64_t"; }
    if str_eq(name, "f64") { return "double"; }
    if str_eq(name, "bool") { return "bool"; }
    if str_eq(name, "str") { return "velox_str"; }
    return cg_mangle("vxt_", name);
}

fn cg_infer_type(source: str, nodes: i64, node: i64,
                   params: i64, body: i64) -> str {
    if node < 0 { return "int64_t"; }
    let kind: i64 = cg_node(nodes,node,0);
    if kind == 20 { return "int64_t"; }
    if kind == 21 { return "double"; }
    if kind == 22 { return "velox_str"; }
    if kind == 23 { return "bool"; }

    if kind == 24 {
        let start: i64 = cg_node(nodes,node,1);
        let end: i64 = cg_node(nodes,node,2);
        let mut param: i64 = params;
        while param >= 0 {
            if str_eq(cg_slice(source,start,end),
                cg_slice(source,cg_node(nodes,param,1),cg_node(nodes,param,2))) {
                return cg_type(source,nodes,cg_node(nodes,param,3));
            }
            param = cg_node(nodes,param,7);
        }

        let mut statement: i64 = cg_node(nodes,body,3);
        while statement >= 0 {
            if cg_node(nodes,statement,0) == 6 {
                let name_start: i64 = cg_node(nodes,statement,6);
                let mut name_end: i64 = name_start;
                while name_end < str_len(source) &&
                    ((str_byte_at(source,name_end) >= 48 && str_byte_at(source,name_end) <= 57) ||
                     (str_byte_at(source,name_end) >= 65 && str_byte_at(source,name_end) <= 90) ||
                     (str_byte_at(source,name_end) >= 97 && str_byte_at(source,name_end) <= 122) ||
                     str_byte_at(source,name_end) == 95) {
                    name_end = name_end + 1;
                }
                if str_eq(cg_slice(source,start,end),cg_slice(source,name_start,name_end)) {
                    let declared: i64 = cg_node(nodes,statement,4);
                    if declared >= 0 { return cg_type(source,nodes,declared); }
                    return cg_infer_type(source,nodes,cg_node(nodes,statement,5),params,body);
                }
            }
            statement = cg_node(nodes,statement,7);
        }
        return "int64_t";
    }

    if kind == 25 {
        return cg_infer_type(source,nodes,cg_node(nodes,node,3),params,body);
    }
    if kind == 26 { return "bool"; }
    if kind == 27 {
        let op: i64 = cg_node(nodes,node,3);
        if op >= 36 && op <= 44 { return "bool"; }
        return cg_infer_type(source,nodes,cg_node(nodes,node,4),params,body);
    }
    if kind == 28 {
        let callee: i64 = cg_node(nodes,node,3);
        let name: str = cg_slice(source,cg_node(nodes,callee,1),cg_node(nodes,callee,2));
        if str_eq(name,"read_file") || str_eq(name,"str_slice") ||
           str_eq(name,"str_concat") { return "velox_str"; }
        if str_eq(name,"str_eq") || str_eq(name,"write_file") { return "bool"; }
        if str_eq(name,"str_len") || str_eq(name,"str_byte_at") ||
           str_eq(name,"str_byte_at_fast") { return "int64_t"; }

        let mut declaration: i64 = cg_node(nodes,0,3);
        while declaration >= 0 {
            if cg_node(nodes,declaration,0) == 1 {
                let function_name: i64 = cg_node(nodes,declaration,4);
                if str_eq(name,cg_slice(source,cg_node(nodes,function_name,1),
                                               cg_node(nodes,function_name,2))) {
                    let meta: i64 = cg_node(nodes,declaration,5);
                    return cg_type(source,nodes,cg_node(nodes,meta,4));
                }
            }
            declaration = cg_node(nodes,declaration,7);
        }
        return "int64_t";
    }
    if kind == 29 {
        let base: i64 = cg_node(nodes,node,3);
        let base_type: str = cg_infer_type(source,nodes,base,params,body);
        let field_start: i64 = cg_node(nodes,node,4);
        let field_end: i64 = cg_node(nodes,node,5);
        let mut declaration: i64 = cg_node(nodes,0,3);

        while declaration >= 0 {
            if cg_node(nodes,declaration,0) == 2 {
                let struct_name: str = cg_mangle("vxt_",
                    cg_slice(source,cg_node(nodes,declaration,5),
                                    cg_node(nodes,declaration,6)));
                if str_eq(base_type,struct_name) {
                    let mut field: i64 = cg_node(nodes,declaration,4);
                    while field >= 0 {
                        if str_eq(
                            cg_slice(source,field_start,field_end),
                            cg_slice(source,cg_node(nodes,field,1),
                                            cg_node(nodes,field,2))) {
                            return cg_type(source,nodes,cg_node(nodes,field,3));
                        }
                        field = cg_node(nodes,field,7);
                    }
                }
            }
            declaration = cg_node(nodes,declaration,7);
        }
        return "int64_t";
    }
    if kind == 30 { return cg_type(source,nodes,cg_node(nodes,node,3)); }
    return "int64_t";
}

fn cg_operator(op: i64) -> str {
    if op == 30 { return "+"; }
    if op == 31 { return "-"; }
    if op == 32 { return "*"; }
    if op == 33 { return "/"; }
    if op == 34 { return "%"; }
    if op == 36 { return "=="; }
    if op == 44 { return "!="; }
    if op == 37 { return "<"; }
    if op == 38 { return ">"; }
    if op == 39 { return "<="; }
    if op == 40 { return ">="; }
    if op == 41 { return "&&"; }
    if op == 42 { return "||"; }
    return "/* unsupported operator */";
}

fn cg_is_string_param(source: str, nodes: i64,
                       params: i64, node: i64) -> bool {
    if node < 0 || cg_node(nodes, node, 0) != 24 {
        return false;
    }

    let variable_name: str = cg_slice(source,
        cg_node(nodes, node, 1), cg_node(nodes, node, 2));

    let mut param: i64 = params;
    while param >= 0 {
        let param_name: str = cg_slice(source,
            cg_node(nodes, param, 1), cg_node(nodes, param, 2));

        if str_eq(variable_name, param_name) {
            let type_node: i64 = cg_node(nodes, param, 3);
            let type_name: str = cg_slice(source,
                cg_node(nodes, type_node, 1),
                cg_node(nodes, type_node, 2));
            return str_eq(type_name, "str");
        }

        param = cg_node(nodes, param, 7);
    }
    return false;
}


fn cg_is_string_local(source: str, nodes: i64,
                      body: i64, node: i64, params: i64) -> bool {
    if node < 0 || cg_node(nodes,node,0) != 24 { return false; }

    let variable_name: str = cg_slice(source,
        cg_node(nodes,node,1),cg_node(nodes,node,2));
    let mut statement: i64 = cg_node(nodes,body,3);

    while statement >= 0 {
        if cg_node(nodes,statement,0) == 6 {
            let name_start: i64 = cg_node(nodes,statement,6);
            let mut name_end: i64 = name_start;
            while name_end < str_len(source) &&
                ((str_byte_at(source,name_end) >= 48 && str_byte_at(source,name_end) <= 57) ||
                 (str_byte_at(source,name_end) >= 65 && str_byte_at(source,name_end) <= 90) ||
                 (str_byte_at(source,name_end) >= 97 && str_byte_at(source,name_end) <= 122) ||
                 str_byte_at(source,name_end) == 95) {
                name_end = name_end + 1;
            }
            if str_eq(variable_name,cg_slice(source,name_start,name_end)) {
                let type_node: i64 = cg_node(nodes,statement,4);
                if type_node >= 0 {
                    return str_eq(cg_slice(source,cg_node(nodes,type_node,1),
                                                  cg_node(nodes,type_node,2)),"str");
                }
                return str_eq(cg_infer_type(source,nodes,
                    cg_node(nodes,statement,5),params,body),"velox_str");
            }
        }
        statement = cg_node(nodes,statement,7);
    }
    return false;
}

fn cg_expr(source: str, nodes: i64, node: i64, params: i64, body: i64) -> str {
    if node < 0 { return "0"; }

    let kind: i64 = cg_node(nodes, node, 0);
    let start: i64 = cg_node(nodes, node, 1);
    let end: i64 = cg_node(nodes, node, 2);

    if kind == 20 || kind == 21 || kind == 22 {
        return cg_slice(source, start, end);
    }
    if kind == 23 {
        if cg_node(nodes, node, 3) == 1 { return "false"; }
        return "true";
    }
    if kind == 24 {
        return cg_mangle("vxv_", cg_slice(source, start, end));
    }
    if kind == 25 {
        return str_concat("(-", str_concat(
            cg_expr(source, nodes, cg_node(nodes, node, 3), params, body), ")"));
    }
    if kind == 26 {
        return str_concat("(!", str_concat(
            cg_expr(source, nodes, cg_node(nodes, node, 3), params, body), ")"));
    }
    if kind == 27 {
        let op: str = cg_operator(cg_node(nodes, node, 3));
        let left: str = cg_expr(source, nodes, cg_node(nodes, node, 4), params, body);
        let right: str = cg_expr(source, nodes, cg_node(nodes, node, 5), params, body);
        return str_concat("(", str_concat(left,
            str_concat(" ", str_concat(op,
                str_concat(" ", str_concat(right, ")"))))));
    }
    if kind == 29 {
        let base: str = cg_expr(source, nodes, cg_node(nodes, node, 3), params, body);
        let mut field: str = cg_slice(source,
            cg_node(nodes, node, 4), cg_node(nodes, node, 5));
        return str_concat("(", str_concat(base,
            str_concat(").", cg_mangle("vxm_", field))));
    }
    if kind == 28 {
        let callee: i64 = cg_node(nodes, node, 3);
        let args: i64 = cg_node(nodes, node, 4);
        let name: str = cg_slice(source,
            cg_node(nodes, callee, 1), cg_node(nodes, callee, 2));
        let mut result: str = "";
        let mut current: i64 = args;
        let mut first: i64 = 1;

        if str_eq(name, "print") || str_eq(name, "println") {
            if current < 0 { return "((void)0)"; }
            let value: str = cg_expr(source, nodes, current, params, body);
            let value_type: str = cg_infer_type(source,nodes,current,params,body);
            if str_eq(value_type,"velox_str") {
                return str_concat("printf(\"%s\\n\", ", str_concat(value, ")"));
            }
            if str_eq(value_type,"double") {
                return str_concat("printf(\"%.17g\\n\", (double)(",
                    str_concat(value, "))"));
            }
            if str_eq(value_type,"bool") {
                return str_concat("printf(\"%s\\n\", (", str_concat(
                    value, ") ? \"true\" : \"false\")"));
            }
            return str_concat("printf(\"%lld\\n\", (long long)(",
                str_concat(value, "))"));
        }

        if str_eq(name, "list_i64_new") {
            return "velox_list_i64_new()";
        }

        let mut target: str = "";
        if str_eq(name, "read_file") { target = "velox_read_file"; }
        if str_eq(name, "write_file") { target = "velox_write_file"; }
        if str_eq(name, "str_len") { target = "velox_str_len"; }
        if str_eq(name, "str_byte_at") { target = "velox_str_byte_at"; }
        if str_eq(name, "str_byte_at_fast") { target = "velox_str_byte_at_fast"; }
        if str_eq(name, "str_slice") { target = "velox_str_slice"; }
        if str_eq(name, "str_concat") { target = "velox_str_concat"; }
        if str_eq(name, "str_eq") { target = "velox_str_eq"; }
        if str_eq(name, "list_i64_push") { target = "velox_list_i64_push"; }
        if str_eq(name, "list_i64_get") { target = "velox_list_i64_get"; }
        if str_eq(name, "list_i64_set") { target = "velox_list_i64_set"; }
        if str_eq(name, "list_i64_len") { target = "velox_list_i64_len"; }

        if str_eq(target, "") {
            target = cg_mangle("vxf_", name);
        }
        result = str_concat(target, "(");
        while current >= 0 {
            if first == 0 { result = str_concat(result, ", "); }
            result = str_concat(result, cg_expr(source, nodes, current, params, body));
            first = 0;
            current = cg_node(nodes, current, 7);
        }
        return str_concat(result, ")");
    }
    if kind == 30 {
        let type_node: i64 = cg_node(nodes, node, 3);
        let type_name: str = cg_slice(source,
            cg_node(nodes, type_node, 1), cg_node(nodes, type_node, 2));
        let args: i64 = cg_node(nodes, node, 4);
        let mut result: str = str_concat("(",
            str_concat(cg_mangle("vxt_", type_name), "){ "));
        let mut current: i64 = args;
        let mut first: i64 = 1;

        while current >= 0 {
            if first == 0 { result = str_concat(result, ", "); }
            let mut field: str = cg_slice(source,
                cg_node(nodes, current, 3), cg_node(nodes, current, 4));
            result = str_concat(result, str_concat(".",
                str_concat(cg_mangle("vxm_", field), " = ")));
            result = str_concat(result,
                cg_expr(source, nodes, cg_node(nodes, current, 5), params, body));
            first = 0;
            current = cg_node(nodes, current, 7);
        }
        return str_concat(result, " }");
    }
    return "0";
}

fn cg_block(source: str, nodes: i64, block: i64, params: i64, body: i64) -> str {
    let mut result: str = "{\n";
    let mut statement: i64 = cg_node(nodes, block, 3);

    while statement >= 0 {
        result = str_concat(result, cg_stmt(source, nodes, statement, params, body));
        statement = cg_node(nodes, statement, 7);
    }
    return str_concat(result, "}\n");
}

fn cg_reduction_has(items: str, name: str) -> bool {
    let n: i64 = str_len(name);
    let total: i64 = str_len(items);
    let mut i: i64 = 0;
    while i + n <= total {
        if str_eq(str_slice(items,i,i+n),name) {
            let left_ok: bool = i == 0 || str_byte_at(items,i-1) == 44;
            let right_ok: bool = i+n == total || str_byte_at(items,i+n) == 44;
            if left_ok && right_ok { return true; }
        }
        i = i + 1;
    }
    return false;
}

fn cg_parallel_reduction(source: str, nodes: i64, body_node: i64) -> str {
    let mut result: str = "";
    let mut statement: i64 = cg_node(nodes,body_node,3);
    while statement >= 0 {
        if cg_node(nodes,statement,0) == 7 {
            let lhs: i64 = cg_node(nodes,statement,3);
            let rhs: i64 = cg_node(nodes,statement,4);
            if lhs >= 0 && rhs >= 0 &&
               cg_node(nodes,lhs,0) == 24 &&
               cg_node(nodes,rhs,0) == 27 &&
               cg_node(nodes,rhs,3) == 30 {
                let ls: i64 = cg_node(nodes,lhs,1);
                let le: i64 = cg_node(nodes,lhs,2);
                let left: i64 = cg_node(nodes,rhs,4);
                let right: i64 = cg_node(nodes,rhs,5);
                let mut valid: bool = false;

                if left >= 0 && cg_node(nodes,left,0) == 24 &&
                   str_eq(cg_slice(source,ls,le),
                       cg_slice(source,cg_node(nodes,left,1),cg_node(nodes,left,2))) {
                    valid = true;
                }
                if right >= 0 && cg_node(nodes,right,0) == 24 &&
                   str_eq(cg_slice(source,ls,le),
                       cg_slice(source,cg_node(nodes,right,1),cg_node(nodes,right,2))) {
                    valid = true;
                }

                if valid {
                    let name: str = cg_mangle("vxv_",cg_slice(source,ls,le));
                    if cg_reduction_has(result,name) == false {
                        if str_eq(result,"") {
                            result = name;
                        } else {
                            result = str_concat(result,str_concat(", ",name));
                        }
                    }
                }
            }
        }
        statement = cg_node(nodes,statement,7);
    }
    return result;
}

fn cg_stmt(source: str, nodes: i64, node: i64, params: i64, body: i64) -> str {
    let kind: i64 = cg_node(nodes, node, 0);

    if kind == 6 {
        let mut mutable: i64 = cg_node(nodes, node, 3);
        let mut type_node: i64 = cg_node(nodes, node, 4);
        let init: i64 = cg_node(nodes, node, 5);
        if type_node < 0 && init >= 0 && cg_node(nodes, init, 0) == 30 {
            type_node = cg_node(nodes, init, 3);
        }
        let name_start: i64 = cg_node(nodes, node, 6);
        let mut name_end: i64 = name_start;
        while name_end < str_len(source) &&
              ((str_byte_at(source, name_end) >= 48 &&
                str_byte_at(source, name_end) <= 57) ||
               (str_byte_at(source, name_end) >= 65 &&
                str_byte_at(source, name_end) <= 90) ||
               (str_byte_at(source, name_end) >= 97 &&
                str_byte_at(source, name_end) <= 122) ||
                str_byte_at(source, name_end) == 95) {
            name_end = name_end + 1;
        }
        let name: str = cg_mangle("vxv_",
            cg_slice(source, name_start, name_end));
        let mut ty: str = cg_type(source, nodes, type_node);
        if type_node < 0 {
            ty = cg_infer_type(source,nodes,init,params,body);
        }
        return str_concat("    ", str_concat(ty,
            str_concat(" ", str_concat(name,
                str_concat(" = ", str_concat(
                    cg_expr(source, nodes, init, params, body), ";\n"))))));
    }
    if kind == 7 {
        return str_concat("    ",
            str_concat(cg_expr(source, nodes, cg_node(nodes, node, 3), params, body),
                str_concat(" = ", str_concat(
                    cg_expr(source, nodes, cg_node(nodes, node, 4), params, body), ";\n"))));
    }
    if kind == 8 {
        return str_concat("    ",
            str_concat(cg_expr(source, nodes, cg_node(nodes, node, 3), params, body),
                str_concat(" = ", str_concat(
                    cg_expr(source, nodes, cg_node(nodes, node, 4), params, body), ";\n"))));
    }
    if kind == 9 {
        let value: i64 = cg_node(nodes, node, 3);
        if value < 0 { return "    return;\n"; }
        return str_concat("    return ",
            str_concat(cg_expr(source, nodes, value, params, body), ";\n"));
    }
    if kind == 10 {
        let condition: str = cg_expr(source, nodes, cg_node(nodes, node, 3), params, body);
        let then_code: str = cg_block(source, nodes, cg_node(nodes, node, 4), params, body);
        let otherwise: i64 = cg_node(nodes, node, 5);
        let mut result: str = str_concat("    if (", str_concat(condition,
            str_concat(") ", then_code)));
        if otherwise >= 0 {
            if cg_node(nodes, otherwise, 0) == 5 {
                result = str_concat(result, str_concat("else ",
                    cg_block(source, nodes, otherwise, params, body)));
            } else {
                result = str_concat(result, cg_stmt(source, nodes, otherwise, params, body));
            }
        }
        return result;
    }
    if kind == 11 {
        return str_concat("    while (",
            str_concat(cg_expr(source, nodes, cg_node(nodes, node, 3), params, body),
                str_concat(") ",
                    cg_block(source, nodes, cg_node(nodes, node, 4), params, body))));
    }
    if kind == 12 {
        let from: str = cg_expr(source, nodes, cg_node(nodes, node, 3), params, body);
        let to: str = cg_expr(source, nodes, cg_node(nodes, node, 4), params, body);
        let loop_body: str = cg_block(source, nodes, cg_node(nodes, node, 5), params, body);
        let name_start: i64 = cg_node(nodes, node, 6);
        let mut name_end: i64 = name_start;
        while name_end < str_len(source) &&
              ((str_byte_at(source, name_end) >= 48 &&
                str_byte_at(source, name_end) <= 57) ||
               (str_byte_at(source, name_end) >= 65 &&
                str_byte_at(source, name_end) <= 90) ||
               (str_byte_at(source, name_end) >= 97 &&
                str_byte_at(source, name_end) <= 122) ||
                str_byte_at(source, name_end) == 95) {
            name_end = name_end + 1;
        }
        let name: str = cg_mangle("vxv_",
            cg_slice(source, name_start, name_end));
        let mut loop_head: str = "    for (int64_t ";
        loop_head = str_concat(loop_head, name);
        loop_head = str_concat(loop_head, " = ");
        loop_head = str_concat(loop_head, from);
        loop_head = str_concat(loop_head, "; ");
        loop_head = str_concat(loop_head, name);
        loop_head = str_concat(loop_head, " < ");
        loop_head = str_concat(loop_head, to);
        loop_head = str_concat(loop_head, "; ");
        loop_head = str_concat(loop_head, name);
        loop_head = str_concat(loop_head, "++) ");
        return str_concat(loop_head, loop_body);
    }
    if kind == 13 {
        let from: str = cg_expr(source, nodes, cg_node(nodes, node, 3), params, body);
        let to: str = cg_expr(source, nodes, cg_node(nodes, node, 4), params, body);
        let loop_body: str = cg_block(source, nodes, cg_node(nodes, node, 5), params, body);
        let name_start: i64 = cg_node(nodes, node, 6);
        let mut name_end: i64 = name_start;
        while name_end < str_len(source) &&
              ((str_byte_at(source,name_end) >= 48 && str_byte_at(source,name_end) <= 57) ||
               (str_byte_at(source,name_end) >= 65 && str_byte_at(source,name_end) <= 90) ||
               (str_byte_at(source,name_end) >= 97 && str_byte_at(source,name_end) <= 122) ||
               str_byte_at(source,name_end) == 95) {
            name_end = name_end + 1;
        }
        let name: str = cg_mangle("vxv_",cg_slice(source,name_start,name_end));
        let mut result: str = "    {\n      int64_t velox_parallel_end = ";
        result = str_concat(result,str_concat(to,";\n"));
        let reduction: str = cg_parallel_reduction(source,nodes,cg_node(nodes,node,5));
        if str_eq(reduction,"") == false {
            result = str_concat(result,"      #pragma omp parallel for reduction(+: ");
            result = str_concat(result,str_concat(reduction,")\n"));
        } else {
            result = str_concat(result,"      #pragma omp parallel for\n");
        }
        result = str_concat(result,"      for (int64_t ");
        result = str_concat(result,name);
        result = str_concat(result," = ");
        result = str_concat(result,from);
        result = str_concat(result,"; ");
        result = str_concat(result,name);
        result = str_concat(result," < velox_parallel_end; ");
        result = str_concat(result,name);
        result = str_concat(result,"++) ");
        result = str_concat(result,loop_body);
        return str_concat(result,"    }\n");
    }
    if kind == 14 {
        return str_concat("    ",
            str_concat(cg_expr(source, nodes, cg_node(nodes, node, 3), params, body), ";\n"));
    }
    return "";
}


fn cg_runtime() -> str {
    let mut result: str = "";
    result = str_concat(result, "\n");
    result = str_concat(result, "#include <string.h>\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static void velox_runtime_fail(const char *message) {\n");
    result = str_concat(result, "    fprintf(stderr, \"Velox runtime error: %s\\n\", message);\n");
    result = str_concat(result, "    exit(EXIT_FAILURE);\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static velox_str velox_read_file(velox_str path) {\n");
    result = str_concat(result, "    FILE *file = fopen(path, \"rb\");\n");
    result = str_concat(result, "    if (!file) velox_runtime_fail(\"cannot open file for reading\");\n");
    result = str_concat(result, "    if (fseek(file, 0, SEEK_END) != 0)\n");
    result = str_concat(result, "        velox_runtime_fail(\"cannot seek input file\");\n");
    result = str_concat(result, "    long size = ftell(file);\n");
    result = str_concat(result, "    if (size < 0) velox_runtime_fail(\"cannot determine input file size\");\n");
    result = str_concat(result, "    if (fseek(file, 0, SEEK_SET) != 0)\n");
    result = str_concat(result, "        velox_runtime_fail(\"cannot rewind input file\");\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "    char *buffer = (char *)malloc((size_t)size + 1);\n");
    result = str_concat(result, "    if (!buffer) velox_runtime_fail(\"out of memory reading file\");\n");
    result = str_concat(result, "    size_t count = fread(buffer, 1, (size_t)size, file);\n");
    result = str_concat(result, "    bool failed = count != (size_t)size || ferror(file);\n");
    result = str_concat(result, "    fclose(file);\n");
    result = str_concat(result, "    if (failed) velox_runtime_fail(\"failed to read input file\");\n");
    result = str_concat(result, "    if (memchr(buffer, '\\0', count))\n");
    result = str_concat(result, "        velox_runtime_fail(\"input file contains an embedded NUL byte\");\n");
    result = str_concat(result, "    buffer[count] = '\\0';\n");
    result = str_concat(result, "    return buffer;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static bool velox_write_file(velox_str path, velox_str content) {\n");
    result = str_concat(result, "    FILE *file = fopen(path, \"wb\");\n");
    result = str_concat(result, "    if (!file) return false;\n");
    result = str_concat(result, "    size_t length = strlen(content);\n");
    result = str_concat(result, "    size_t written = fwrite(content, 1, length, file);\n");
    result = str_concat(result, "    int close_result = fclose(file);\n");
    result = str_concat(result, "    return written == length && close_result == 0;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_str_len(velox_str value) {\n");
    result = str_concat(result, "    return (int64_t)strlen(value);\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_str_byte_at(velox_str value, int64_t index) {\n");
    result = str_concat(result, "    size_t length = strlen(value);\n");
    result = str_concat(result, "    if (index < 0 || (uint64_t)index >= length)\n");
    result = str_concat(result, "        velox_runtime_fail(\"string byte index out of bounds\");\n");
    result = str_concat(result, "    return (int64_t)(unsigned char)value[index];\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_str_byte_at_fast(velox_str value, int64_t index, int64_t length) {\n");
    result = str_concat(result, "    if (index < 0 || length < 0 || index >= length)\n");
    result = str_concat(result, "        velox_runtime_fail(\"string byte index out of bounds\");\n");
    result = str_concat(result, "    return (int64_t)(unsigned char)value[index];\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static velox_str velox_str_slice(velox_str value, int64_t start, int64_t end) {\n");
    result = str_concat(result, "    size_t length = strlen(value);\n");
    result = str_concat(result, "    if (start < 0 || end < start || (uint64_t)end > length)\n");
    result = str_concat(result, "        velox_runtime_fail(\"invalid string slice bounds\");\n");
    result = str_concat(result, "    size_t count = (size_t)(end - start);\n");
    result = str_concat(result, "    char *result = (char *)malloc(count + 1);\n");
    result = str_concat(result, "    if (!result) velox_runtime_fail(\"out of memory slicing string\");\n");
    result = str_concat(result, "    memcpy(result, value + start, count);\n");
    result = str_concat(result, "    result[count] = '\\0';\n");
    result = str_concat(result, "    return result;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static velox_str velox_str_concat(velox_str left, velox_str right) {\n");
    result = str_concat(result, "    size_t a = strlen(left), b = strlen(right);\n");
    result = str_concat(result, "    if (a > SIZE_MAX - b - 1)\n");
    result = str_concat(result, "        velox_runtime_fail(\"string concatenation size overflow\");\n");
    result = str_concat(result, "    char *result = (char *)malloc(a + b + 1);\n");
    result = str_concat(result, "    if (!result) velox_runtime_fail(\"out of memory concatenating strings\");\n");
    result = str_concat(result, "    memcpy(result, left, a);\n");
    result = str_concat(result, "    memcpy(result + a, right, b + 1);\n");
    result = str_concat(result, "    return result;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static bool velox_str_eq(velox_str left, velox_str right) {\n");
    result = str_concat(result, "    return strcmp(left, right) == 0;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "typedef struct {\n");
    result = str_concat(result, "    int64_t *data;\n");
    result = str_concat(result, "    size_t len;\n");
    result = str_concat(result, "    size_t cap;\n");
    result = str_concat(result, "} velox_i64_list;\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static velox_i64_list *velox_get_i64_list(int64_t handle) {\n");
    result = str_concat(result, "    velox_i64_list *list = (velox_i64_list *)(intptr_t)handle;\n");
    result = str_concat(result, "    if (!list) velox_runtime_fail(\"invalid integer list handle\");\n");
    result = str_concat(result, "    return list;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_list_i64_new(void) {\n");
    result = str_concat(result, "    velox_i64_list *list = (velox_i64_list *)calloc(1, sizeof(*list));\n");
    result = str_concat(result, "    if (!list) velox_runtime_fail(\"out of memory creating integer list\");\n");
    result = str_concat(result, "    return (int64_t)(intptr_t)list;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static void velox_list_i64_push(int64_t handle, int64_t value) {\n");
    result = str_concat(result, "    velox_i64_list *list = velox_get_i64_list(handle);\n");
    result = str_concat(result, "    if (list->len == list->cap) {\n");
    result = str_concat(result, "        size_t next = list->cap ? list->cap * 2 : 8;\n");
    result = str_concat(result, "        if (next < list->cap || next > SIZE_MAX / sizeof(int64_t))\n");
    result = str_concat(result, "            velox_runtime_fail(\"integer list capacity overflow\");\n");
    result = str_concat(result, "        int64_t *data = (int64_t *)realloc(list->data, next * sizeof(int64_t));\n");
    result = str_concat(result, "        if (!data) velox_runtime_fail(\"out of memory growing integer list\");\n");
    result = str_concat(result, "        list->data = data;\n");
    result = str_concat(result, "        list->cap = next;\n");
    result = str_concat(result, "    }\n");
    result = str_concat(result, "    list->data[list->len++] = value;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_list_i64_get(int64_t handle, int64_t index) {\n");
    result = str_concat(result, "    velox_i64_list *list = velox_get_i64_list(handle);\n");
    result = str_concat(result, "    if (index < 0 || (uint64_t)index >= list->len)\n");
    result = str_concat(result, "        velox_runtime_fail(\"integer list index out of bounds\");\n");
    result = str_concat(result, "    return list->data[index];\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static void velox_list_i64_set(int64_t handle, int64_t index, int64_t value) {\n");
    result = str_concat(result, "    velox_i64_list *list = velox_get_i64_list(handle);\n");
    result = str_concat(result, "    if (index < 0 || (uint64_t)index >= list->len)\n");
    result = str_concat(result, "        velox_runtime_fail(\"integer list index out of bounds\");\n");
    result = str_concat(result, "    list->data[index] = value;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_list_i64_len(int64_t handle) {\n");
    result = str_concat(result, "    velox_i64_list *list = velox_get_i64_list(handle);\n");
    result = str_concat(result, "    if (list->len > INT64_MAX)\n");
    result = str_concat(result, "        velox_runtime_fail(\"integer list length overflow\");\n");
    result = str_concat(result, "    return (int64_t)list->len;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static void velox_i64_fail(const char *operation) {\n");
    result = str_concat(result, "    fprintf(stderr, \"Velox runtime error: %s\\n\", operation);\n");
    result = str_concat(result, "    exit(EXIT_FAILURE);\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_add(int64_t a, int64_t b) {\n");
    result = str_concat(result, "    int64_t result;\n");
    result = str_concat(result, "    if (__builtin_add_overflow(a, b, &result))\n");
    result = str_concat(result, "        velox_i64_fail(\"i64 addition overflow\");\n");
    result = str_concat(result, "    return result;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_sub(int64_t a, int64_t b) {\n");
    result = str_concat(result, "    int64_t result;\n");
    result = str_concat(result, "    if (__builtin_sub_overflow(a, b, &result))\n");
    result = str_concat(result, "        velox_i64_fail(\"i64 subtraction overflow\");\n");
    result = str_concat(result, "    return result;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_mul(int64_t a, int64_t b) {\n");
    result = str_concat(result, "    int64_t result;\n");
    result = str_concat(result, "    if (__builtin_mul_overflow(a, b, &result))\n");
    result = str_concat(result, "        velox_i64_fail(\"i64 multiplication overflow\");\n");
    result = str_concat(result, "    return result;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_div(int64_t a, int64_t b) {\n");
    result = str_concat(result, "    if (b == 0) velox_i64_fail(\"i64 division by zero\");\n");
    result = str_concat(result, "    if (a == INT64_MIN && b == -1)\n");
    result = str_concat(result, "        velox_i64_fail(\"i64 division overflow\");\n");
    result = str_concat(result, "    return a / b;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_mod(int64_t a, int64_t b) {\n");
    result = str_concat(result, "    if (b == 0) velox_i64_fail(\"i64 modulo by zero\");\n");
    result = str_concat(result, "    if (a == INT64_MIN && b == -1) return 0;\n");
    result = str_concat(result, "    return a % b;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    result = str_concat(result, "static int64_t velox_i64_neg(int64_t a) {\n");
    result = str_concat(result, "    if (a == INT64_MIN) velox_i64_fail(\"i64 negation overflow\");\n");
    result = str_concat(result, "    return -a;\n");
    result = str_concat(result, "}\n");
    result = str_concat(result, "\n");
    return result;
}

fn cg_function(source: str, nodes: i64, function: i64) -> str {
    let name_node: i64 = cg_node(nodes, function, 4);
    let meta: i64 = cg_node(nodes, function, 5);
    let name: str = cg_slice(source,
        cg_node(nodes, name_node, 1), cg_node(nodes, name_node, 2));
    let params: i64 = cg_node(nodes, meta, 3);
    let ret: i64 = cg_node(nodes, meta, 4);
    let body: i64 = cg_node(nodes, meta, 5);

    let mut result: str = "";
    if str_eq(name, "main") {
        result = "int main(";
    } else {
        result = str_concat(cg_type(source, nodes, ret),
            str_concat(" ", str_concat(cg_mangle("vxf_", name), "(")));
    }

    let mut current: i64 = params;
    let mut first: i64 = 1;
    while current >= 0 {
        if first == 0 { result = str_concat(result, ", "); }
        let ptype: str = cg_type(source, nodes, cg_node(nodes, current, 3));
        let pname: str = cg_slice(source,
            cg_node(nodes, current, 1), cg_node(nodes, current, 2));
        result = str_concat(result, str_concat(ptype,
            str_concat(" ", cg_mangle("vxv_", pname))));
        first = 0;
        current = cg_node(nodes, current, 7);
    }
    if first == 1 { result = str_concat(result, "void"); }
    result = str_concat(result, ") ");
    result = str_concat(result, cg_block(source, nodes, body, params, body));
    if str_eq(name, "main") {
        result = str_concat(result, "\n");
    }
    return result;
}

fn cg_struct(source: str, nodes: i64, structure: i64) -> str {
    let name: str = cg_slice(source,
        cg_node(nodes, structure, 5), cg_node(nodes, structure, 6));
    let mut result: str = str_concat("typedef struct ",
        str_concat(cg_mangle("vxt_", name),
            str_concat(" {\n", "")));
    let mut field: i64 = cg_node(nodes, structure, 4);
    while field >= 0 {
        let mut ty: str = cg_type(source, nodes, cg_node(nodes, field, 3));
        let fname: str = cg_slice(source,
            cg_node(nodes, field, 1), cg_node(nodes, field, 2));
        result = str_concat(result, str_concat("    ", str_concat(ty,
            str_concat(" ", str_concat(cg_mangle("vxm_", fname), ";\n")))));
        field = cg_node(nodes, field, 7);
    }
    return str_concat(result, str_concat("} ",
        str_concat(cg_mangle("vxt_", name), ";\n\n")));
}


fn cg_function_decl(source: str, nodes: i64, function: i64) -> str {
    let name_node: i64 = cg_node(nodes, function, 4);
    let meta: i64 = cg_node(nodes, function, 5);
    let name: str = cg_slice(source,
        cg_node(nodes, name_node, 1), cg_node(nodes, name_node, 2));

    if str_eq(name, "main") { return ""; }

    let params: i64 = cg_node(nodes, meta, 3);
    let ret: i64 = cg_node(nodes, meta, 4);
    let mut result: str = str_concat(cg_type(source, nodes, ret),
        str_concat(" ", str_concat(cg_mangle("vxf_", name), "(")));

    let mut current: i64 = params;
    let mut first: i64 = 1;
    while current >= 0 {
        if first == 0 { result = str_concat(result, ", "); }
        let ptype: str = cg_type(source, nodes, cg_node(nodes, current, 3));
        let pname: str = cg_slice(source,
            cg_node(nodes, current, 1), cg_node(nodes, current, 2));
        result = str_concat(result, str_concat(ptype,
            str_concat(" ", cg_mangle("vxv_", pname))));
        first = 0;
        current = cg_node(nodes, current, 7);
    }
    if first == 1 { result = str_concat(result, "void"); }
    return str_concat(result, ");\n");
}

pub fn generate_c(source: str, nodes: i64) -> str {
    if ast_has_error(nodes) { return ""; }

    let mut result: str =
        "#include <stdio.h>\n#include <stdint.h>\n#include <stdbool.h>\n#include <stdlib.h>\n#include <string.h>\ntypedef const char* velox_str;\n\n";
    result = str_concat(result, cg_runtime());
    result = str_concat(result, "\n");


    let mut declaration: i64 = cg_node(nodes, 0, 3);
    while declaration >= 0 {
        if cg_node(nodes, declaration, 0) == 2 {
            result = str_concat(result, cg_struct(source, nodes, declaration));
        }
        declaration = cg_node(nodes, declaration, 7);
    }

    declaration = cg_node(nodes, 0, 3);
    while declaration >= 0 {
        if cg_node(nodes, declaration, 0) == 1 {
            result = str_concat(result,
                cg_function_decl(source, nodes, declaration));
        }
        declaration = cg_node(nodes, declaration, 7);
    }

    result = str_concat(result, "\n");

    declaration = cg_node(nodes, 0, 3);
    while declaration >= 0 {
        if cg_node(nodes, declaration, 0) == 1 {
            result = str_concat(result,
                cg_function(source, nodes, declaration));
        }
        declaration = cg_node(nodes, declaration, 7);
    }
    return result;
}

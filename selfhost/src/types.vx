using "ast.vx"
// Velox self-hosted type checker.
// Type IDs: 1=i64, 2=f64, 3=bool, 4=str, 5=void, 100+=struct.

fn tc_ident_end(source: str, start: i64) -> i64 {
    let n: i64 = str_len(source);
    let mut end: i64 = start;
    while end < n {
        let c: i64 = str_byte_at_fast(source,end,n);
        if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) ||
           c == 95 || (c >= 48 && c <= 57) {
            end = end + 1;
        } else {
            return end;
        }
    }
    return end;
}

fn tc_arg_type(state: i64, source: str, args: i64, index: i64, vars: i64) -> i64 {
    let mut arg: i64 = args;
    let mut i: i64 = 0;
    while arg >= 0 && i < index {
        arg = ast_node_data(list_i64_get(state,0),arg,7);
        i = i + 1;
    }
    if arg < 0 { return -1; }
    return tc_expr(state,source,arg,vars);
}

fn tc_type_name(state: i64, source: str, type_node: i64) -> i64 {
    if type_node < 0 { return 5; }
    let start: i64 = ast_node_data(list_i64_get(state,0),type_node,1);
    let end: i64 = ast_node_data(list_i64_get(state,0),type_node,2);
    let name: str = str_slice(source, start, end);
    if str_eq(name, "i64") { return 1; }
    if str_eq(name, "f64") { return 2; }
    if str_eq(name, "bool") { return 3; }
    if str_eq(name, "str") { return 4; }
    if str_eq(name, "void") { return 5; }
    let mut i: i64 = 0;
    while i < list_i64_len(list_i64_get(state,4)) / 3 {
        let p: i64 = i * 3;
        if str_eq(str_slice(source, list_i64_get(list_i64_get(state,4),p), list_i64_get(list_i64_get(state,4),p+1)), name) {
            return 100 + i;
        }
        i = i + 1;
    }
    return -1;
}

fn tc_name_equal(state: i64, source: str, a: i64, b: i64) -> bool {
    return str_eq(
        str_slice(source, ast_node_data(list_i64_get(state,0),a,1), ast_node_data(list_i64_get(state,0),a,2)),
        str_slice(source, ast_node_data(list_i64_get(state,0),b,1), ast_node_data(list_i64_get(state,0),b,2))
    );
}

fn tc_find_var(state: i64, source: str, vars: i64, start: i64, end: i64) -> i64 {
    let mut i: i64 = list_i64_get(state,6);
    while i > 0 {
        i = i - 1;
        let p: i64 = i * 5;
        if str_eq(str_slice(source,start,end),
            str_slice(source,list_i64_get(vars,p),list_i64_get(vars,p+1))) {
            return p;
        }
    }
    return -1;
}

fn tc_add_var(state: i64, vars: i64, start: i64, end: i64, ty: i64, mutable: i64) {
    let p: i64 = list_i64_get(state,6) * 5;
    while list_i64_len(vars) < p + 5 {
        list_i64_push(vars,0);
    }
    list_i64_set(vars,p,start);
    list_i64_set(vars,p+1,end);
    list_i64_set(vars,p+2,ty);
    list_i64_set(vars,p+3,mutable);
    list_i64_set(vars,p+4,list_i64_get(state,7));
    list_i64_set(state,6,list_i64_get(state,6)+1);
}

fn tc_find_function(state: i64, source: str, name_start: i64, name_end: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_i64_len(list_i64_get(state,3)) / 5 {
        let p: i64 = i * 5;
        if str_eq(str_slice(source,name_start,name_end),
            str_slice(source,list_i64_get(list_i64_get(state,3),p),list_i64_get(list_i64_get(state,3),p+1))) {
            return p;
        }
        i = i + 1;
    }
    return -1;
}

fn tc_find_struct(state: i64, source: str, name_start: i64, name_end: i64) -> i64 {
    let mut i: i64 = 0;
    while i < list_i64_len(list_i64_get(state,4)) / 3 {
        let p: i64 = i * 3;
        if str_eq(str_slice(source,name_start,name_end),
            str_slice(source,list_i64_get(list_i64_get(state,4),p),list_i64_get(list_i64_get(state,4),p+1))) {
            return p;
        }
        i = i + 1;
    }
    return -1;
}

fn tc_expr(state: i64, source: str, node: i64, vars: i64) -> i64 {
    if node < 0 { return -1; }
    let kind: i64 = ast_node_kind(list_i64_get(state,0),node);
    let a: i64 = ast_node_data(list_i64_get(state,0),node,3);
    let b: i64 = ast_node_data(list_i64_get(state,0),node,4);
    let c: i64 = ast_node_data(list_i64_get(state,0),node,5);

    if kind == 20 { return 1; }
    if kind == 21 { return 2; }
    if kind == 22 { return 4; }
    if kind == 23 { return 3; }

    if kind == 24 {
        let start: i64 = ast_node_data(list_i64_get(state,0),node,1);
        let end: i64 = ast_node_data(list_i64_get(state,0),node,2);
        let p: i64 = tc_find_var(state, source,vars,start,end);
        if p >= 0 { return list_i64_get(vars,p+2); }
        return -1;
    }

    if kind == 25 {
        let t: i64 = tc_expr(state, source,a,vars);
        if t == 1 || t == 2 { return t; }
        return -1;
    }

    if kind == 26 {
        if tc_expr(state, source,a,vars) == 3 { return 3; }
        return -1;
    }

    if kind == 27 {
        let left: i64 = tc_expr(state, source,b,vars);
        let mut right: i64 = tc_expr(state, source,c,vars);
        if left < 0 || right < 0 { return -1; }
        if a == 41 || a == 42 {
            if left == 3 && right == 3 { return 3; }
            return -1;
        }
        if a == 36 || a == 44 {
            if left == right && (left == 1 || left == 2 || left == 3) { return 3; }
            return -1;
        }
        if a == 37 || a == 38 || a == 39 || a == 40 {
            if left == right && (left == 1 || left == 2) { return 3; }
            return -1;
        }
        if left == right && (left == 1 || left == 2) {
            if a == 34 && left == 2 { return -1; }
            return left;
        }
        return -1;
    }

    if kind == 29 {
        let base: i64 = tc_expr(state, source,a,vars);
        if base < 100 { return -1; }
        let si: i64 = (base - 100) * 3;
        let field_start: i64 = b;
        let field_end: i64 = c;
        let structure: i64 = list_i64_get(list_i64_get(state,4),si+2);
        let mut f: i64 = structure;
        while f >= 0 {
            let fs: i64 = ast_node_data(list_i64_get(state,0),f,1);
            let fe: i64 = ast_node_data(list_i64_get(state,0),f,2);
            if str_eq(str_slice(source,field_start,field_end),str_slice(source,fs,fe)) {
                return tc_type_name(state, source,ast_field_type(list_i64_get(state,0),f));
            }
            f = ast_node_data(list_i64_get(state,0),f,7);
        }
        return -1;
    }

    if kind == 28 {
        let callee: i64 = a;
        let callee_kind: i64 = ast_node_kind(list_i64_get(state,0),callee);
        if callee_kind < 24 || callee_kind > 24 { return -1; }

        let ns: i64 = ast_node_data(list_i64_get(state,0),callee,1);
        let ne: i64 = ast_node_data(list_i64_get(state,0),callee,2);
        let name: str = str_slice(source,ns,ne);
        let mut arg: i64 = b;
        let mut count: i64 = 0;
        let mut valid: bool = true;

        while arg >= 0 {
            if tc_expr(state,source,arg,vars) < 0 { valid = false; }
            count = count + 1;
            arg = ast_node_data(list_i64_get(state,0),arg,7);
        }
        if !valid { return -1; }

        let t0: i64 = tc_arg_type(state,source,b,0,vars);
        let t1: i64 = tc_arg_type(state,source,b,1,vars);
        let t2: i64 = tc_arg_type(state,source,b,2,vars);

        if str_eq(name,"print") || str_eq(name,"println") || str_eq(name,"write") {
            if count == 1 { return 5; }
            return -1;
        }

        if str_eq(name,"read_file") {
            if count == 1 && t0 == 4 { return 4; }
            return -1;
        }
        if str_eq(name,"write_file") {
            if count == 2 && t0 == 4 && t1 == 4 { return 3; }
            return -1;
        }
        if str_eq(name,"str_len") {
            if count == 1 && t0 == 4 { return 1; }
            return -1;
        }
        if str_eq(name,"str_byte_at") {
            if count == 2 && t0 == 4 && t1 == 1 { return 1; }
            return -1;
        }
        if str_eq(name,"str_byte_at_fast") {
            if count == 3 && t0 == 4 && t1 == 1 && t2 == 1 { return 1; }
            return -1;
        }
        if str_eq(name,"str_slice") {
            if count == 3 && t0 == 4 && t1 == 1 && t2 == 1 { return 4; }
            return -1;
        }
        if str_eq(name,"str_concat") {
            if count == 2 && t0 == 4 && t1 == 4 { return 4; }
            return -1;
        }
        if str_eq(name,"str_eq") {
            if count == 2 && t0 == 4 && t1 == 4 { return 3; }
            return -1;
        }
        if str_eq(name,"list_i64_new") {
            if count == 0 { return 1; }
            return -1;
        }
        if str_eq(name,"list_i64_push") {
            if count == 2 && t0 == 1 && t1 == 1 { return 5; }
            return -1;
        }
        if str_eq(name,"list_i64_get") {
            if count == 2 && t0 == 1 && t1 == 1 { return 1; }
            return -1;
        }
        if str_eq(name,"list_i64_set") {
            if count == 3 && t0 == 1 && t1 == 1 && t2 == 1 { return 5; }
            return -1;
        }
        if str_eq(name,"list_i64_len") {
            if count == 1 && t0 == 1 { return 1; }
            return -1;
        }

        let fp: i64 = tc_find_function(state,source,ns,ne);
        if fp < 0 { return -1; }
        if count > list_i64_get(list_i64_get(state,3),fp+4) || count < list_i64_get(list_i64_get(state,3),fp+4) { return -1; }

        let mut param: i64 = list_i64_get(list_i64_get(state,3),fp+2);
        arg = b;
        while param >= 0 && arg >= 0 {
            let expected: i64 = tc_type_name(state,source,ast_parameter_type(list_i64_get(state,0),param));
            let actual: i64 = tc_expr(state,source,arg,vars);
            if expected < 0 || actual < expected || actual > expected { return -1; }
            param = ast_node_data(list_i64_get(state,0),param,7);
            arg = ast_node_data(list_i64_get(state,0),arg,7);
        }
        return list_i64_get(list_i64_get(state,3),fp+3);
    }

    if kind == 30 {
        let name_start: i64 = ast_node_data(list_i64_get(state,0),a,1);
        let name_end: i64 = ast_node_data(list_i64_get(state,0),a,2);
        let sp: i64 = tc_find_struct(state, source,name_start,name_end);
        if sp < 0 { return -1; }
        let fields: i64 = list_i64_get(list_i64_get(state,4),sp+2);
        let mut arg: i64 = b;
        let mut count: i64 = 0;
        while arg >= 0 {
            let field_start: i64 = ast_node_data(list_i64_get(state,0),arg,3);
            let field_end: i64 = ast_node_data(list_i64_get(state,0),arg,4);
            let actual: i64 = tc_expr(state, source,ast_node_data(list_i64_get(state,0),arg,5),vars);

            // Reject duplicate field initializers.
            let mut prior: i64 = b;
            let mut duplicate: bool = false;
            while prior >= 0 && !(prior == arg) {
                if str_eq(
                    str_slice(source,field_start,field_end),
                    str_slice(source,
                        ast_node_data(list_i64_get(state,0),prior,3),
                        ast_node_data(list_i64_get(state,0),prior,4))
                ) {
                    duplicate = true;
                }
                prior = ast_node_data(list_i64_get(state,0),prior,7);
            }

            let mut f: i64 = fields;
            let mut found: i64 = -1;
            while f >= 0 {
                if str_eq(str_slice(source,field_start,field_end),
                    str_slice(source,ast_node_data(list_i64_get(state,0),f,1),ast_node_data(list_i64_get(state,0),f,2))) {
                    found = tc_type_name(state, source,ast_field_type(list_i64_get(state,0),f));
                }
                f = ast_node_data(list_i64_get(state,0),f,7);
            }
            if duplicate || found < 0 || found < actual || found > actual { return -1; }
            count = count + 1;
            arg = ast_node_data(list_i64_get(state,0),arg,7);
        }
        let mut total: i64 = 0;
        let mut f: i64 = fields;
        while f >= 0 {
            total = total + 1;
            f = ast_node_data(list_i64_get(state,0),f,7);
        }
        if count == total { return 100 + sp / 3; }
        return -1;
    }
    return -1;
}


fn tc_field_root_var(state: i64, source: str, expr: i64, vars: i64) -> i64 {
    if expr < 0 { return -1; }

    let nodes: i64 = list_i64_get(state,0);
    let kind: i64 = ast_node_kind(nodes,expr);

    if kind == 24 {
        let ns: i64 = ast_node_data(nodes,expr,1);
        let ne: i64 = ast_node_data(nodes,expr,2);
        return tc_find_var(state,source,vars,ns,ne);
    }

    if kind == 29 {
        return tc_field_root_var(
            state,source,ast_node_data(nodes,expr,3),vars
        );
    }

    return -1;
}


fn tc_parallel_reduction(state: i64, source: str, lhs: i64, rhs: i64, vars: i64) -> bool {
    let nodes: i64 = list_i64_get(state,0);
    if lhs < 0 || rhs < 0 { return false; }
    if ast_node_kind(nodes,lhs) != 24 || ast_node_kind(nodes,rhs) != 27 {
        return false;
    }
    if ast_node_data(nodes,rhs,3) != 30 { return false; }

    let ls: i64 = ast_node_data(nodes,lhs,1);
    let le: i64 = ast_node_data(nodes,lhs,2);
    let lp: i64 = tc_find_var(state,source,vars,ls,le);
    if lp < 0 { return false; }

    let reduction_type: i64 = list_i64_get(vars,lp+2);
    if reduction_type != 1 && reduction_type != 2 { return false; }
    if tc_expr(state,source,rhs,vars) != reduction_type { return false; }

    let left: i64 = ast_node_data(nodes,rhs,4);
    let right: i64 = ast_node_data(nodes,rhs,5);

    if left >= 0 && ast_node_kind(nodes,left) == 24 &&
       str_eq(str_slice(source,ls,le),
              str_slice(source,ast_node_data(nodes,left,1),
                              ast_node_data(nodes,left,2))) {
        if right >= 0 {
            if ast_node_kind(nodes,right) == 24 {
                let rp: i64 = tc_find_var(state,source,vars,
                    ast_node_data(nodes,right,1),ast_node_data(nodes,right,2));
                if rp == list_i64_get(state,10) * 5 { return true; }
            } else {
                if reduction_type == 2 && ast_node_kind(nodes,right) == 21 {
                    return true;
                }
            }
        }
    }

    if right >= 0 && ast_node_kind(nodes,right) == 24 &&
       str_eq(str_slice(source,ls,le),
              str_slice(source,ast_node_data(nodes,right,1),
                              ast_node_data(nodes,right,2))) {
        if left >= 0 {
            if ast_node_kind(nodes,left) == 24 {
                let lp2: i64 = tc_find_var(state,source,vars,
                    ast_node_data(nodes,left,1),ast_node_data(nodes,left,2));
                if lp2 == list_i64_get(state,10) * 5 { return true; }
            } else {
                if (reduction_type == 1 && ast_node_kind(nodes,left) == 20) ||
                   (reduction_type == 2 && ast_node_kind(nodes,left) == 21) {
                    return true;
                }
            }
        }
    }
    return false;
}

fn tc_block(state: i64, source: str, block: i64, vars: i64, return_type: i64, is_parallel: bool) -> bool {
    let mut statement: i64 = ast_node_data(list_i64_get(state,0),block,3);
    let saved: i64 = list_i64_get(state,6);
    let mut returned: bool = false;
    while statement >= 0 && list_i64_get(state,1) == 0 {
        let kind: i64 = ast_node_kind(list_i64_get(state,0),statement);
        let a: i64 = ast_node_data(list_i64_get(state,0),statement,3);
        let b: i64 = ast_node_data(list_i64_get(state,0),statement,4);
        let c: i64 = ast_node_data(list_i64_get(state,0),statement,5);

        // Struct field assignment diagnostics.
        if kind == 8 {
            let root: i64 = tc_field_root_var(state,source,a,vars);
            let expected: i64 = tc_expr(state,source,a,vars);
            let actual: i64 = tc_expr(state,source,b,vars);
            if root < 0 {
                list_i64_set(state,1,1);
                list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                list_i64_set(state,7,502);
            } else {
                if list_i64_get(vars,root+3) == 0 ||
                   (is_parallel && root / 5 < list_i64_get(state,10)) {
                    list_i64_set(state,1,1);
                    list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                    list_i64_set(state,7,501);
                    list_i64_set(state,8,list_i64_get(vars,root));
                    list_i64_set(state,9,list_i64_get(vars,root+1));
                } else {
                    if expected < 0 || actual < 0 || expected < actual || expected > actual {
                        list_i64_set(state,1,1);
                        list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                        list_i64_set(state,7,308);
                        list_i64_set(state,8,expected);
                        list_i64_set(state,9,actual);
                    }
                }
            }
        }


        if kind == 6 {
            let ns: i64 = ast_node_data(list_i64_get(state,0),statement,6);
            let name_end: i64 = tc_ident_end(source,ns);
            let actual: i64 = tc_expr(state, source,c,vars);
            let mut declared: i64 = actual;
            if b >= 0 { declared = tc_type_name(state, source,b); }
            if actual < 0 || declared < 0 || actual > declared || actual < declared || declared == 5 {
                list_i64_set(state,1,1);
                list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
            } else {
                tc_add_var(state, vars,ns,name_end,declared,a);
            }
        } else {
            if kind == 7 {
                let ns: i64 = ast_node_data(list_i64_get(state,0),a,1);
                let ne: i64 = ast_node_data(list_i64_get(state,0),a,2);
                let p: i64 = tc_find_var(state,source,vars,ns,ne);
                let actual: i64 = tc_expr(state,source,b,vars);
                if p < 0 {
                    list_i64_set(state,1,1);
                    list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                } else {
                    if list_i64_get(vars,p+3) == 0 ||
                       (is_parallel && p / 5 < list_i64_get(state,10) &&
                        ((list_i64_get(vars,p+2) != 1 && list_i64_get(vars,p+2) != 2) ||
                         tc_parallel_reduction(state,source,a,b,vars) == false)) ||
                       actual < list_i64_get(vars,p+2) ||
                       actual > list_i64_get(vars,p+2) {
                        list_i64_set(state,1,1);
                        list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                    }
                }
            } else {
                if kind == 9 {
                    let mut invalid: bool = is_parallel;
                    if a < 0 {
                        if return_type != 5 {
                            invalid = true;
                        }
                    } else {
                        let actual: i64 = tc_expr(state,source,a,vars);
                        if actual < 0 || actual > return_type || actual < return_type {
                            invalid = true;
                        }
                        if return_type == 5 {
                            invalid = true;
                        }
                    }
                    if invalid {
                        list_i64_set(state,1,1);
                        list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                    }
                    returned = true;
                } else {
                    if kind == 10 {
                        if tc_expr(state, source,a,vars) < 3 || tc_expr(state, source,a,vars) > 3 {
                            list_i64_set(state,1,1);
                            list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                        }
                        let left: bool = tc_block(state, source,b,vars,return_type,is_parallel);
                        let mut right: bool = false;
                        if c >= 0 { right = tc_block(state, source,c,vars,return_type,is_parallel); }
                        if left && right { returned = true; }
                    } else {
                        if kind == 11 {
                            if tc_expr(state, source,a,vars) < 3 || tc_expr(state, source,a,vars) > 3 {
                                list_i64_set(state,1,1);
                                list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                            }
                            tc_block(state, source,b,vars,return_type,is_parallel);
                        } else {
                            if kind == 12 || kind == 13 {
                                let from_type: i64 = tc_expr(state,source,a,vars);
                                let to_type: i64 = tc_expr(state,source,b,vars);
                                if (is_parallel && kind == 13) || from_type != 1|| to_type != 1{
                                    list_i64_set(state,1,1);
                                    list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                                }
                                let loop_start: i64 = ast_node_data(list_i64_get(state,0),statement,6);
                                let loop_end: i64 = tc_ident_end(source,loop_start);
                                let outer_count: i64 = list_i64_get(state,6);
                                let old_parallel_boundary: i64 = list_i64_get(state,10);
                                if kind == 13 {
                                    list_i64_set(state,10,outer_count);
                                }
                                tc_add_var(state,vars,loop_start,loop_end,1,0);
                                tc_block(state,source,c,vars,return_type,is_parallel || kind == 13);
                                list_i64_set(state,6,outer_count);
                                list_i64_set(state,10,old_parallel_boundary);
                            } else {
                                if kind == 14 {
                                    if tc_expr(state, source,a,vars) < 0 {
                                        list_i64_set(state,1,1);
                                        list_i64_set(state,2,ast_node_data(list_i64_get(state,0),statement,1));
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        statement = ast_node_data(list_i64_get(state,0),statement,7);
    }
    list_i64_set(state,6,saved);
    return returned;
}

pub fn typecheck(state: i64, source: str, nodes: i64) -> bool {
    while list_i64_len(state) < 11 {
        list_i64_push(state,0);
    }
    list_i64_set(state,0,nodes);
    list_i64_set(state,1,0);
    list_i64_set(state,2,0);
    list_i64_set(state,3,list_i64_new());
    list_i64_set(state,4,list_i64_new());
    list_i64_set(state,5,list_i64_new());
    list_i64_set(state,6,0);
    list_i64_set(state,7,0);
    list_i64_set(state,10,-1);

    let mut declaration: i64 = ast_node_data(nodes,0,3);
    while declaration >= 0 {
        let kind: i64 = ast_node_kind(nodes,declaration);
        if kind == 2 {
            let ns: i64 = ast_struct_name_start(nodes,declaration);
            let ne: i64 = ast_struct_name_end(nodes,declaration);
            let fields: i64 = ast_struct_fields(nodes,declaration);
            list_i64_push(list_i64_get(state,4),ns);
            list_i64_push(list_i64_get(state,4),ne);
            list_i64_push(list_i64_get(state,4),fields);
        }
        declaration = ast_node_data(nodes,declaration,7);
    }

    declaration = ast_node_data(nodes,0,3);
    while declaration >= 0 {
        if ast_node_kind(nodes,declaration) == 1 {
            let name: i64 = ast_function_name(nodes,declaration);
            let meta: i64 = ast_function_meta(nodes,declaration);
            let ns: i64 = ast_node_data(nodes,name,1);
            let ne: i64 = ast_node_data(nodes,name,2);
            let ret: i64 = tc_type_name(state, source,ast_function_return_type(nodes,declaration));
            let params: i64 = ast_function_params(nodes,declaration);
            let mut count: i64 = 0;
            let mut p: i64 = params;
            while p >= 0 {
                count = count + 1;
                p = ast_node_data(nodes,p,7);
            }
            if tc_find_function(state, source,ns,ne) >= 0 {
                list_i64_set(state,1,1);
                list_i64_set(state,2,ns);
            } else {
                list_i64_push(list_i64_get(state,3),ns);
                list_i64_push(list_i64_get(state,3),ne);
                list_i64_push(list_i64_get(state,3),params);
                list_i64_push(list_i64_get(state,3),ret);
                list_i64_push(list_i64_get(state,3),count);
            }
        }
        declaration = ast_node_data(nodes,declaration,7);
    }

    declaration = ast_node_data(nodes,0,3);
    while declaration >= 0 {
        if ast_node_kind(nodes,declaration) == 1 {
            let name: i64 = ast_function_name(nodes,declaration);
            let ns: i64 = ast_node_data(nodes,name,1);
            let ne: i64 = ast_node_data(nodes,name,2);
            let fp: i64 = tc_find_function(state, source,ns,ne);
            let ret: i64 = list_i64_get(list_i64_get(state,3),fp+3);
            let params: i64 = list_i64_get(list_i64_get(state,3),fp+2);
            let vars: i64 = list_i64_new();
            list_i64_set(state,6,0);
            let mut p: i64 = params;
            while p >= 0 {
                let ps: i64 = ast_node_data(nodes,p,1);
                let pe: i64 = ast_node_data(nodes,p,2);
                let pt: i64 = tc_type_name(state, source,ast_parameter_type(nodes,p));
                if pt < 0 || pt == 5 || tc_find_var(state, source,vars,ps,pe) >= 0 {
                    list_i64_set(state,1,1);
                    list_i64_set(state,2,ps);
                } else {
                    tc_add_var(state, vars,ps,pe,pt,0);
                }
                p = ast_node_data(nodes,p,7);
            }
            let body: i64 = ast_function_body(nodes,declaration);
            if body >= 0 {
                let returns: bool = tc_block(state, source,body,vars,ret,false);
                if (ret != 5 ) && !returns {
                    list_i64_set(state,1,1);
                    list_i64_set(state,2,ns);
                }
            }
        }
        declaration = ast_node_data(nodes,declaration,7);
    }
    return list_i64_get(state,1) == 0;
}

pub fn typecheck_error_position(state: i64) -> i64 {
    return list_i64_get(state,2);
}

pub fn typecheck_error_code(state: i64) -> i64 {
    return list_i64_get(state,7);
}

pub fn typecheck_error_data(state: i64, index: i64) -> i64 {
    if index == 0 { return list_i64_get(state,8); }
    return list_i64_get(state,9);
}

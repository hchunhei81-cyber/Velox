using "lexer.vx";
using "ast.vx";
using "parser.vx";
using "types.vx";
using "codegen.vx";

fn main() {
    let source: str = "struct Pair { a: i64, b: i64 } struct Profile { title: str, score: f64, active: bool } struct Inner { label: str } struct Outer { inner: Inner } fn add(a: i64, b: i64) -> i64 { return a + b; } fn main() -> void { let text: str = \"Velox\"; println(text); println(true); println(false); let mut sum: i64 = 0; for i in 0..3 { sum = sum + i; } let mut n: i64 = 0; while n < 2 { sum = sum + n; n = n + 1; } let mut total_a: i64 = 0; let mut total_b: i64 = 0; parallel for j in 0..3 { total_a = total_a + j; total_b = j + total_b; } let p = Pair { a: sum, b: 2 }; println(p.a + p.b); let profile = Profile { title: \"Velox\", score: 9.5, active: true }; let inferred_title = profile.title; let inferred_score = profile.score; let inferred_active = profile.active; let inner = Inner { label: \"nested\" }; let outer = Outer { inner: inner }; let inferred_nested = outer.inner.label; println(add(20, 22)); let inferred_i = 7; let inferred_f = 1.5; let inferred_s = \"inferred\"; let inferred_b = true; let inferred_copy = inferred_i; let inferred_sum = inferred_i + 3; let inferred_cmp = inferred_i < 10; let inferred_call = add(20, 22); }";

    let tokens: i64 = tokenize(source);
    let nodes: i64 = parse_program(tokens);

    if ast_has_error(nodes) {
        println("PARSER FAILED");
        return;
    }

    let state: i64 = list_i64_new();
    if !typecheck(state, source, nodes) {
        println("TYPECHECK FAILED");
        println(typecheck_error_position(state));
        return;
    }

    let output: str = generate_c(source, nodes);
    if str_len(output) == 0 {
        println("CODEGEN FAILED");
        return;
    }

    write_file("/tmp/velox-stage1-generated.c", output);
    println("CODEGEN PASSED");
}

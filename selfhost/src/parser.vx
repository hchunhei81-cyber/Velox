// Recursive-descent parser for Velox.
//
// Parser state:
// [tokens, cursor, AST node pool, error flag]
//
// Token layout:
// [kind, source_start, source_end]

fn p_kind(state: i64) -> i64 {
    let tokens: i64 = list_i64_get(state, 0);
    let pos: i64 = list_i64_get(state, 1);
    let count: i64 = list_i64_len(tokens) / 3;
    if pos >= count { return 0; }
    return list_i64_get(tokens, pos * 3);
}

fn p_kind_at(state: i64, offset: i64) -> i64 {
    let tokens: i64 = list_i64_get(state, 0);
    let pos: i64 = list_i64_get(state, 1) + offset;
    let count: i64 = list_i64_len(tokens) / 3;
    if pos >= count { return 0; }
    return list_i64_get(tokens, pos * 3);
}

fn p_start_at(state: i64, index: i64) -> i64 {
    let tokens: i64 = list_i64_get(state, 0);
    let count: i64 = list_i64_len(tokens) / 3;
    if index < 0 || index >= count { return 0; }
    return list_i64_get(tokens, index * 3 + 1);
}

fn p_end_at(state: i64, index: i64) -> i64 {
    let tokens: i64 = list_i64_get(state, 0);
    let count: i64 = list_i64_len(tokens) / 3;
    if index < 0 || index >= count { return 0; }
    return list_i64_get(tokens, index * 3 + 2);
}

fn p_pos(state: i64) -> i64 {
    return list_i64_get(state, 1);
}

fn p_advance(state: i64) -> i64 {
    let kind: i64 = p_kind(state);
    list_i64_set(state, 1, p_pos(state) + 1);
    return kind;
}

fn p_match(state: i64, kind: i64) -> bool {
    if p_kind(state) == kind {
        p_advance(state);
        return true;
    }
    return false;
}

fn p_expect(state: i64, kind: i64) -> bool {
    if p_match(state, kind) {
        return true;
    }
    list_i64_set(state, 3, 1);
    list_i64_set(state, 4, p_pos(state));
    return false;
}

fn p_fail(state: i64) -> i64 {
    list_i64_set(state, 3, 1);
    list_i64_set(state, 4, p_pos(state));
    return -1;
}

fn p_node(state: i64, kind: i64, start: i64, end: i64,
          a: i64, b: i64, c: i64, d: i64) -> i64 {
    let nodes: i64 = list_i64_get(state, 2);
    let index: i64 = list_i64_len(nodes) / 8;
    list_i64_push(nodes, kind);
    list_i64_push(nodes, start);
    list_i64_push(nodes, end);
    list_i64_push(nodes, a);
    list_i64_push(nodes, b);
    list_i64_push(nodes, c);
    list_i64_push(nodes, d);
    list_i64_push(nodes, -1);
    return index;
}

fn p_append(state: i64, tail: i64, item: i64) -> i64 {
    let nodes: i64 = list_i64_get(state, 2);
    if tail >= 0 {
        list_i64_set(nodes, tail * 8 + 7, item);
    }
    return item;
}

fn p_make_binary(state: i64, op: i64, left: i64, right: i64) -> i64 {
    let nodes: i64 = list_i64_get(state, 2);
    let start: i64 = list_i64_get(nodes, left * 8 + 1);
    let end: i64 = list_i64_get(nodes, right * 8 + 2);
    return p_node(state, 27, start, end, op, left, right, -1);
}

fn p_parse_type(state: i64) -> i64 {
    if !(p_kind(state) == 1) {
        return p_fail(state);
    }
    let index: i64 = p_pos(state);
    p_advance(state);
    return p_node(state, 32, p_start_at(state, index),
                p_end_at(state, index), -1, -1, -1, -1);
}

fn p_parse_parameter(state: i64) -> i64 {
    if !(p_kind(state) == 1) {
        return p_fail(state);
    }
    let name_index: i64 = p_pos(state);
    p_advance(state);
    if p_expect(state, 26) == false { return -1; }
    let ty: i64 = p_parse_type(state);
    if ty < 0 { return -1; }
    let nodes: i64 = list_i64_get(state, 2);
    return p_node(state, 3, p_start_at(state, name_index),
                  p_end_at(state, name_index), ty, -1, -1, -1);
}

fn p_parse_struct_field(state: i64) -> i64 {
    if !(p_kind(state) == 1) { return p_fail(state); }
    let name_index: i64 = p_pos(state);
    p_advance(state);
    if p_expect(state, 26) == false { return -1; }
    let ty: i64 = p_parse_type(state);
    if ty < 0 { return -1; }
    return p_node(state, 4, p_start_at(state, name_index),
                  p_end_at(state, name_index), ty, -1, -1, -1);
}

fn p_parse_block(state: i64) -> i64 {
    if !(p_kind(state) == 22) { return p_fail(state); }
    let start: i64 = p_start_at(state, p_pos(state));
    p_advance(state);

    let head: i64 = -1;
    let mut tail: i64 = -1;
    let mut first: i64 = head;

    while !(p_kind(state) == 23) && !(p_kind(state) == 0) &&
          list_i64_get(state, 3) == 0 {
        let item: i64 = p_parse_statement(state);
        if item < 0 { return -1; }
        if first < 0 { first = item; }
        tail = p_append(state, tail, item);
    }

    if p_expect(state, 23) == false { return -1; }
    return p_node(state, 5, start,
                  p_end_at(state, p_pos(state) - 1),
                  first, -1, -1, -1);
}

fn p_parse_function(state: i64, visibility: i64, decl_start: i64) -> i64 {
    let fn_index: i64 = p_pos(state);
    if p_expect(state, 5) == false { return -1; }
    if !(p_kind(state) == 1) { return p_fail(state); }

    let name_index: i64 = p_pos(state);
    p_advance(state);
    if p_expect(state, 20) == false { return -1; }

    let params: i64 = -1;
    let mut param_tail: i64 = -1;
    let mut param_head: i64 = params;
    let mut parsing_params: i64 = 1;

    while !(p_kind(state) == 21) && !(p_kind(state) == 0) &&
          list_i64_get(state, 3) == 0 && parsing_params == 1 {
        let param: i64 = p_parse_parameter(state);
        if param < 0 { return -1; }
        if param_head < 0 { param_head = param; }
        param_tail = p_append(state, param_tail, param);
        if p_match(state, 24) == false { parsing_params = 0; }
    }

    if p_expect(state, 21) == false { return -1; }

    let ret: i64 = -1;
    let mut return_type: i64 = ret;
    if p_match(state, 27) {
        return_type = p_parse_type(state);
        if return_type < 0 { return -1; }
    }

    let body: i64 = p_parse_block(state);
    if body < 0 { return -1; }

    let nodes: i64 = list_i64_get(state, 2);
    let body_end: i64 = list_i64_get(nodes, body * 8 + 2);

    let name_node: i64 = p_node(
        state, 33,
        p_start_at(state, name_index),
        p_end_at(state, name_index),
        -1, -1, -1, -1
    );

    let meta_node: i64 = p_node(
        state, 34,
        p_start_at(state, name_index),
        body_end,
        param_head, return_type, body, -1
    );

    return p_node(state, 1, p_start_at(state, decl_start),
                  body_end, visibility, name_node,
                  meta_node, -1);
}

fn p_parse_struct(state: i64, visibility: i64, decl_start: i64) -> i64 {
    if p_expect(state, 6) == false { return -1; }
    if !(p_kind(state) == 1) { return p_fail(state); }
    let name_index: i64 = p_pos(state);
    p_advance(state);
    if p_expect(state, 22) == false { return -1; }

    let mut head: i64 = -1;
    let mut tail: i64 = -1;

    while !(p_kind(state) == 23) && !(p_kind(state) == 0) &&
          list_i64_get(state, 3) == 0 {
        let field: i64 = p_parse_struct_field(state);
        if field < 0 { return -1; }
        if head < 0 { head = field; }
        tail = p_append(state, tail, field);

        if p_match(state, 24) == false {
            p_match(state, 25);
            if !(p_kind(state) == 23) { return p_fail(state); }
        }
    }

    if p_expect(state, 23) == false { return -1; }
    return p_node(state, 2, p_start_at(state, decl_start),
                  p_end_at(state, p_pos(state) - 1),
                  visibility, head,
                  p_start_at(state, name_index),
                  p_end_at(state, name_index));
}

fn p_parse_let(state: i64) -> i64 {
    let start: i64 = p_start_at(state, p_pos(state));
    p_advance(state);
    let mut mutable: i64 = 0;
    if p_match(state, 8) { mutable = 1; }

    if !(p_kind(state) == 1) { return p_fail(state); }
    let name_index: i64 = p_pos(state);
    p_advance(state);

    let mut ty: i64 = -1;
    if p_match(state, 26) {
        ty = p_parse_type(state);
        if ty < 0 { return -1; }
    }

    if p_expect(state, 35) == false { return -1; }
    let init: i64 = p_parse_expression(state);
    if init < 0 { return -1; }
    if p_expect(state, 25) == false { return -1; }

    return p_node(state, 6, start,
                  p_end_at(state, p_pos(state) - 1),
                  mutable, ty, init,
                  p_start_at(state, name_index));
}

fn p_parse_return(state: i64) -> i64 {
    let start: i64 = p_start_at(state, p_pos(state));
    p_advance(state);
    let mut value: i64 = -1;
    if !(p_kind(state) == 25) {
        value = p_parse_expression(state);
        if value < 0 { return -1; }
    }
    if p_expect(state, 25) == false { return -1; }
    return p_node(state, 9, start,
                  p_end_at(state, p_pos(state) - 1),
                  value, -1, -1, -1);
}

fn p_parse_if(state: i64) -> i64 {
    let start: i64 = p_start_at(state, p_pos(state));
    p_advance(state);
    let condition: i64 = p_parse_expression(state);
    if condition < 0 { return -1; }
    let then_block: i64 = p_parse_block(state);
    if then_block < 0 { return -1; }

    let mut else_block: i64 = -1;
    if p_match(state, 11) {
        if p_kind(state) == 10 {
            else_block = p_parse_if(state);
        } else {
            else_block = p_parse_block(state);
        }
        if else_block < 0 { return -1; }
    }

    return p_node(state, 10, start,
                  p_end_at(state, p_pos(state) - 1),
                  condition, then_block, else_block, -1);
}

fn p_parse_while(state: i64) -> i64 {
    let start: i64 = p_start_at(state, p_pos(state));
    p_advance(state);
    let condition: i64 = p_parse_expression(state);
    if condition < 0 { return -1; }
    let body: i64 = p_parse_block(state);
    if body < 0 { return -1; }
    return p_node(state, 11, start,
                  p_end_at(state, p_pos(state) - 1),
                  condition, body, -1, -1);
}

fn p_parse_for(state: i64, is_parallel: i64) -> i64 {
    let start: i64 = p_start_at(state, p_pos(state));
    if is_parallel > 0 {
        if p_expect(state, 17) == false { return -1; }
    }
    if p_expect(state, 13) == false { return -1; }
    if !(p_kind(state) == 1) { return p_fail(state); }

    let name_index: i64 = p_pos(state);
    p_advance(state);
    if p_expect(state, 14) == false { return -1; }

    let from: i64 = p_parse_expression(state);
    if from < 0 { return -1; }
    if p_expect(state, 28) == false { return -1; }
    let to: i64 = p_parse_expression(state);
    if to < 0 { return -1; }
    let body: i64 = p_parse_block(state);
    if body < 0 { return -1; }

    return p_node(state, 12 + is_parallel, start,
                  p_end_at(state, p_pos(state) - 1),
                  from, to, body,
                  p_start_at(state, name_index));
}

fn p_parse_statement(state: i64) -> i64 {
    let kind: i64 = p_kind(state);
    if kind == 7 { return p_parse_let(state); }
    if kind == 9 { return p_parse_return(state); }
    if kind == 10 { return p_parse_if(state); }
    if kind == 12 { return p_parse_while(state); }
    if kind == 13 { return p_parse_for(state, 0); }
    if kind == 17 { return p_parse_for(state, 1); }

    let left: i64 = p_parse_expression(state);
    if left < 0 { return -1; }

    if p_match(state, 35) {
        let right: i64 = p_parse_expression(state);
        if right < 0 { return -1; }
        if p_expect(state, 25) == false { return -1; }
        let nodes: i64 = list_i64_get(state, 2);
        let left_kind: i64 = list_i64_get(nodes, left * 8);
        if left_kind == 24 {
            return p_node(state, 7,
                          list_i64_get(nodes, left * 8 + 1),
                          p_end_at(state, p_pos(state) - 1),
                          left, right, -1, -1);
        }
        if left_kind == 29 {
            return p_node(state, 8,
                          list_i64_get(nodes, left * 8 + 1),
                          p_end_at(state, p_pos(state) - 1),
                          left, right, -1, -1);
        }
        return p_fail(state);
    }

    if p_expect(state, 25) == false { return -1; }
    return p_node(state, 14,
                  list_i64_get(list_i64_get(state, 2), left * 8 + 1),
                  p_end_at(state, p_pos(state) - 1),
                  left, -1, -1, -1);
}

fn p_parse_expression(state: i64) -> i64 {
    return p_parse_or(state);
}

fn p_parse_or(state: i64) -> i64 {
    let mut left: i64 = p_parse_and(state);
    if left < 0 { return -1; }
    while p_kind(state) == 42 {
        let op: i64 = p_advance(state);
        let right: i64 = p_parse_and(state);
        if right < 0 { return -1; }
        left = p_make_binary(state, op, left, right);
    }
    return left;
}

fn p_parse_and(state: i64) -> i64 {
    let mut left: i64 = p_parse_compare(state);
    if left < 0 { return -1; }
    while p_kind(state) == 41 {
        let op: i64 = p_advance(state);
        let right: i64 = p_parse_compare(state);
        if right < 0 { return -1; }
        left = p_make_binary(state, op, left, right);
    }
    return left;
}

fn p_parse_compare(state: i64) -> i64 {
    let mut left: i64 = p_parse_add(state);
    if left < 0 { return -1; }

    while p_kind(state) == 36 || p_kind(state) == 37 ||
          p_kind(state) == 38 || p_kind(state) == 39 ||
          p_kind(state) == 40 {
        let op: i64 = p_advance(state);
        let right: i64 = p_parse_add(state);
        if right < 0 { return -1; }
        left = p_make_binary(state, op, left, right);
    }
    return left;
}

fn p_parse_add(state: i64) -> i64 {
    let mut left: i64 = p_parse_mul(state);
    if left < 0 { return -1; }

    while p_kind(state) == 30 || p_kind(state) == 31 {
        let op: i64 = p_advance(state);
        let right: i64 = p_parse_mul(state);
        if right < 0 { return -1; }
        left = p_make_binary(state, op, left, right);
    }
    return left;
}

fn p_parse_mul(state: i64) -> i64 {
    let mut left: i64 = p_parse_unary(state);
    if left < 0 { return -1; }

    while p_kind(state) == 32 || p_kind(state) == 33 ||
          p_kind(state) == 34 {
        let op: i64 = p_advance(state);
        let right: i64 = p_parse_unary(state);
        if right < 0 { return -1; }
        left = p_make_binary(state, op, left, right);
    }
    return left;
}

fn p_parse_unary(state: i64) -> i64 {
    if p_kind(state) == 31 || p_kind(state) == 43 {
        let op: i64 = p_advance(state);
        let value: i64 = p_parse_unary(state);
        if value < 0 { return -1; }
        let nodes: i64 = list_i64_get(state, 2);
        let start: i64 = p_start_at(state, p_pos(state) - 1);
        let end: i64 = list_i64_get(nodes, value * 8 + 2);
        if op == 31 {
            return p_node(state, 25, start, end, value, -1, -1, -1);
        }
        return p_node(state, 26, start, end, value, -1, -1, -1);
    }
    return p_parse_postfix(state);
}


// Parse either positional call arguments or named struct fields.
// close_kind: 21 for ')', 23 for '}'.
// named: 1 requires name: expression; 0 parses ordinary expressions.
fn p_parse_argument_list(state: i64, close_kind: i64, named: i64) -> i64 {
    let mut head: i64 = -1;
    let mut tail: i64 = -1;
    let mut parsing: i64 = 1;

    while !(p_kind(state) == close_kind) && !(p_kind(state) == 0) &&
          list_i64_get(state, 3) == 0 && parsing == 1 {
        let mut arg: i64 = -1;

        if named == 1 {
            if !(p_kind(state) == 1) { return p_fail(state); }

            let name_index: i64 = p_pos(state);
            p_advance(state);

            if p_expect(state, 26) == false { return -1; }

            let expression: i64 = p_parse_expression(state);
            if expression < 0 { return -1; }

            let nodes: i64 = list_i64_get(state, 2);
            let expression_end: i64 =
                list_i64_get(nodes, expression * 8 + 2);

            arg = p_node(
                state, 31,
                p_start_at(state, name_index),
                expression_end,
                p_start_at(state, name_index),
                p_end_at(state, name_index),
                expression, -1
            );
        } else {
            arg = p_parse_expression(state);
            if arg < 0 { return -1; }
        }

        if head < 0 { head = arg; }
        tail = p_append(state, tail, arg);

        if p_match(state, 24) {
            // Accept a trailing comma.
            if p_kind(state) == close_kind {
                parsing = 0;
            }
        } else {
            parsing = 0;
        }
    }

    if p_expect(state, close_kind) == false { return -1; }
    return head;
}

fn p_parse_postfix(state: i64) -> i64 {
    let mut value: i64 = p_parse_atom(state);
    if value < 0 { return -1; }

    let mut parsing: i64 = 1;
    while parsing == 1 && list_i64_get(state, 3) == 0 {
        if p_kind(state) == 29 {
            p_advance(state);

            if !(p_kind(state) == 1) { return p_fail(state); }

            let name_index: i64 = p_pos(state);
            p_advance(state);

            let nodes: i64 = list_i64_get(state, 2);
            value = p_node(
                state, 29,
                list_i64_get(nodes, value * 8 + 1),
                p_end_at(state, name_index),
                value,
                p_start_at(state, name_index),
                p_end_at(state, name_index), -1
            );
        } else {
            if p_kind(state) == 20 {
                p_advance(state);

                let mut is_struct: i64 = 0;
                if p_kind(state) == 1 && p_kind_at(state, 1) == 26 {
                    is_struct = 1;
                }

                let args: i64 = p_parse_argument_list(state, 21, is_struct);
                if list_i64_get(state, 3) > 0 { return -1; }

                let nodes: i64 = list_i64_get(state, 2);
                let end: i64 = p_end_at(state, p_pos(state) - 1);
                let start: i64 = list_i64_get(nodes, value * 8 + 1);

                if is_struct == 1 {
                    value = p_node(state, 30, start, end,
                                   value, args, -1, -1);
                } else {
                    value = p_node(state, 28, start, end,
                                   value, args, -1, -1);
                }
            } else {
                if p_kind(state) == 22 {
                    let nodes: i64 = list_i64_get(state, 2);
                    let base_kind: i64 =
                        list_i64_get(nodes, value * 8);

                    // Only a variable followed by '{' can start a
                    // brace-style struct initializer. Otherwise leave
                    // the brace for the enclosing block parser.
                    if base_kind == 24 {
                        p_advance(state);
                        let args: i64 = p_parse_argument_list(state, 23, 1);
                        if list_i64_get(state, 3) > 0 { return -1; }

                        let end: i64 = p_end_at(state, p_pos(state) - 1);
                        let start: i64 =
                            list_i64_get(nodes, value * 8 + 1);

                        value = p_node(state, 30, start, end,
                                       value, args, -1, -1);
                    } else {
                        parsing = 0;
                    }
                } else {
                    parsing = 0;
                }
            }
        }
    }

    return value;
}

fn p_parse_atom(state: i64) -> i64 {
    let kind: i64 = p_kind(state);
    let index: i64 = p_pos(state);
    let start: i64 = p_start_at(state, index);
    let end: i64 = p_end_at(state, index);

    if kind == 2 {
        p_advance(state);
        return p_node(state, 20, start, end, -1, -1, -1, -1);
    }
    if kind == 3 {
        p_advance(state);
        return p_node(state, 21, start, end, -1, -1, -1, -1);
    }
    if kind == 4 {
        p_advance(state);
        return p_node(state, 22, start, end, -1, -1, -1, -1);
    }
    if kind == 15 || kind == 16 {
        p_advance(state);
        return p_node(state, 23, start, end, kind - 15, -1, -1, -1);
    }
    if kind == 1 {
        p_advance(state);
        return p_node(state, 24, start, end, -1, -1, -1, -1);
    }
    if kind == 20 {
        p_advance(state);
        let value: i64 = p_parse_expression(state);
        if value < 0 { return -1; }
        if p_expect(state, 21) == false { return -1; }
        return value;
    }
    return p_fail(state);
}

pub fn parse_program(tokens: i64) -> i64 {
    let state: i64 = list_i64_new();
    let nodes: i64 = list_i64_new();

    list_i64_push(state, tokens);
    list_i64_push(state, 0);
    list_i64_push(state, nodes);
    list_i64_push(state, 0);
    list_i64_push(state, -1);

    // Root node is always index zero.
    list_i64_push(nodes, 100);
    list_i64_push(nodes, 0);
    list_i64_push(nodes, 0);
    list_i64_push(nodes, -1);
    list_i64_push(nodes, -1);
    list_i64_push(nodes, -1);
    list_i64_push(nodes, 0);
    list_i64_push(nodes, -1);

    let mut head: i64 = -1;
    let mut tail: i64 = -1;

    let mut parsing_program: i64 = 1;
    while !(p_kind(state) == 0) && list_i64_get(state, 3) == 0 &&
        parsing_program == 1 {
        let decl_start: i64 = p_pos(state);
        let mut visibility: i64 = 0;

        if p_match(state, 18) { visibility = 1; }
        else if p_match(state, 19) { visibility = 2; }

        let kind: i64 = p_kind(state);
        let mut declaration: i64 = -1;

        if kind == 5 {
            declaration = p_parse_function(state, visibility, decl_start);
        } else {
            if kind == 6 {
                declaration = p_parse_struct(state, visibility, decl_start);
            } else {
                declaration = p_fail(state);
            }
        }

        if declaration < 0 || list_i64_get(state, 3) > 0 {
            list_i64_set(nodes, 6, 1);
            parsing_program = 0;
        }

        if head < 0 { head = declaration; }
        tail = p_append(state, tail, declaration);
    }

    list_i64_set(nodes, 3, head);
    list_i64_set(nodes, 4, tail);
    list_i64_set(nodes, 5, list_i64_get(state, 4));
    list_i64_set(nodes, 6, list_i64_get(state, 3));
    return nodes;
}

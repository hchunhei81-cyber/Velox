{
  "Function": {
    "prefix": [
      "fn",
      "func"
    ],
    "body": [
      "fn ${1:name}(${2}) -> ${3:void} {",
      "    $0",
      "}"
    ],
    "description": "Create a Velox function"
  },
  "Public Function": {
    "prefix": "pubfn",
    "body": [
      "public fn ${1:name}(${2}) -> ${3:void} {",
      "    $0",
      "}"
    ],
    "description": "Create a public function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "fn main() -> void {",
      "    $0",
      "}"
    ],
    "description": "Create the program entry point"
  },
  "Struct": {
    "prefix": [
      "struct",
      "st"
    ],
    "body": [
      "struct ${1:Point} {",
      "    ${2:x}: ${3:f64},",
      "    ${4:y}: ${5:f64},",
      "}",
      "$0"
    ],
    "description": "Create a struct"
  },
  "Public Struct": {
    "prefix": "pubstruct",
    "body": [
      "public struct ${1:Point} {",
      "    ${2:x}: ${3:f64},",
      "}",
      "$0"
    ],
    "description": "Create a public struct"
  },
  "Struct Literal": {
    "prefix": "newstruct",
    "body": [
      "${1:Point} {",
      "    ${2:x}: ${3:0.0},",
      "    ${4:y}: ${5:0.0},",
      "}"
    ],
    "description": "Initialize a struct value"
  },
  "Immutable Variable": {
    "prefix": "let",
    "body": [
      "let ${1:name}: ${2:i64} = ${3:0};"
    ],
    "description": "Create an immutable variable"
  },
  "Mutable Variable": {
    "prefix": [
      "mut",
      "letmut"
    ],
    "body": [
      "let mut ${1:name}: ${2:i64} = ${3:0};"
    ],
    "description": "Create a mutable variable"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create an if statement"
  },
  "If Else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition} {",
      "    ${2}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Create an if-else statement"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while ${1:condition} {",
      "    $0",
      "}"
    ],
    "description": "Create a while loop"
  },
  "Parallel For": {
    "prefix": [
      "pfor",
      "parallel"
    ],
    "body": [
      "parallel for ${1:i} in ${2:0}..${3:100} {",
      "    $0",
      "}"
    ],
    "description": "Create a parallel for loop"
  },
  "Return": {
    "prefix": "ret",
    "body": [
      "return ${1:value};"
    ],
    "description": "Return a value"
  },
  "Print": {
    "prefix": "pr",
    "body": [
      "print(${1:value});"
    ],
    "description": "Print a numeric or boolean value"
  },
  "Print Line": {
    "prefix": "pln",
    "body": [
      "println(${1:\"text\"});"
    ],
    "description": "Print a string"
  },
  "Boolean Condition": {
    "prefix": "bool",
    "body": [
      "let ${1:ready}: bool = ${2:true};"
    ],
    "description": "Declare a boolean"
  },
  "Logical Condition": {
    "prefix": "andor",
    "body": [
      "${1:ready} && ${2:valid}"
    ],
    "description": "Boolean AND expression"
  },
  "Python Import": {
    "prefix": "pyimport",
    "body": [
      "import python ${1:math};"
    ],
    "description": "Import a Python module"
  },
  "Python Call": {
    "prefix": "pycall",
    "body": [
      "py.${1:math}.${2:sqrt}(${3:144.0})"
    ],
    "description": "Call a function from an imported Python module"
  }
}
